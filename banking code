class BankAccount:
    def __init__(self, name, account_number, pin, balance):
        self.name = name
        self.account_number = account_number
        self.pin = pin
        self.balance = balance
        self.history = []

    def check_balance(self):
        print(f"\nCurrent Balance: ₹{self.balance:.2f}")

    def deposit(self):
        amount = float(input("Enter deposit amount: ₹"))
        if amount > 0:
            self.balance += amount
            self.history.append(f"Deposited ₹{amount:.2f}")
            print("Deposit Successful!")
        else:
            print("Invalid amount!")

    def withdraw(self):
        amount = float(input("Enter withdrawal amount: ₹"))
        if amount <= 0:
            print("Invalid amount!")
        elif amount > self.balance:
            print("Insufficient Balance!")
        else:
            self.balance -= amount
            self.history.append(f"Withdrawn ₹{amount:.2f}")
            print("Withdrawal Successful!")

    def change_pin(self):
        old_pin = input("Enter current PIN: ")
        if old_pin == self.pin:
            new_pin = input("Enter new 4-digit PIN: ")
            confirm = input("Confirm new PIN: ")

            if new_pin == confirm:
                self.pin = new_pin
                print("PIN changed successfully!")
            else:
                print("PINs do not match!")
        else:
            print("Incorrect current PIN!")

    def transaction_history(self):
        print("\n----- Transaction History -----")
        if not self.history:
            print("No transactions found.")
        else:
            for transaction in self.history:
                print(transaction)


account = BankAccount(
    name="Umal Salma",
